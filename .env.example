# Postgres (Neon in production; local strapi_console DB for dev)
# DIRECT_URL is required by Prisma migrations/introspection against Neon's pooled connection.
DATABASE_URL=postgresql://user:password@host:5432/strapi_console?sslmode=require&pgbouncer=true
DIRECT_URL=postgresql://user:password@host:5432/strapi_console?sslmode=require

# Must match console's API_TOKEN_SALT exactly â€” used to verify existing Strapi API tokens
# (Authorization: Bearer <token>) via HMAC-SHA512, so nexus/serwise/serwise-website keep working
# unchanged. Copy the value from console/.env.production.
API_TOKEN_SALT=

# /cms Content-Type Builder: "true" lets the builder create/alter/drop content tables (runs DDL).
# Set ONLY on local + watchtower-dev. Prod stays unset (builder is view-only there) and receives
# schema changes via `yarn cms:sync-schema` (see scripts/cms-sync-schema.ts).
CMS_SCHEMA_EDITING=

# Same Cloudinary account console uses, so existing media URLs keep resolving.
CLOUDINARY_NAME=
CLOUDINARY_KEY=
CLOUDINARY_SECRET=

# Root login (`/`) â€” phone+OTP+passkey. The only login: it also gates /cms and /operators.
# Signs the pending-2FA cookie and the full root session JWT.
ROOT_JWT_SECRET=

# HanuOTP SMS provider â€” same account/config as nexus (see nexus/.env.local), reused here so the
# same provider sends OTPs for both apps.
HANUOTP_API_KEY=
HANUOTP_TEMPLATE_SID=

# WebAuthn relying party config for passkey enrollment/login.
# RP_ID must be the bare domain (no scheme/port) the passkey is scoped to; localhost in dev.
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=Watchtower
WEBAUTHN_ORIGIN=http://localhost:3000

# Nexus API â€” used by /tickets to read Complaint records as an ADMIN service caller.
# NEXUS_JWT_SECRET must match nexus's JWT_SECRET exactly (see nexus/.env.local) â€” watchtower
# signs its own short-lived ADMIN-role token rather than logging in as a real nexus user.
NEXUS_API_URL=http://localhost:3000/api
NEXUS_JWT_SECRET=

# Supabase Realtime â€” live notifications + auto-refresh from nexus (see src/components/RealtimeFeed.tsx).
# Same project/anon key as serwise. SUPABASE_ADMIN_CHANNEL must match nexus's value exactly and be
# unguessable (e.g. `openssl rand -hex 24`) â€” anyone with the anon key can join a channel by name.
# All three are server-only; they're handed to the browser only after the root session is verified.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_ADMIN_CHANNEL=

# serwise-website cache refresh on web-page / login edits (see src/lib/website/revalidate.ts)
WEBSITE_REVALIDATE_URL=          # e.g. https://serwise.co.in/api/revalidate
WEBSITE_REVALIDATE_SECRET=       # same value as the website's CMS_REVALIDATE_SECRET
