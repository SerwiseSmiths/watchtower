# Postgres (Neon in production; local strapi_console DB for dev)
# DIRECT_URL is required by Prisma migrations/introspection against Neon's pooled connection.
DATABASE_URL=postgresql://user:password@host:5432/strapi_console?sslmode=require&pgbouncer=true
DIRECT_URL=postgresql://user:password@host:5432/strapi_console?sslmode=require

# Must match console's API_TOKEN_SALT exactly — used to verify existing Strapi API tokens
# (Authorization: Bearer <token>) via HMAC-SHA512, so nexus/serwise/serwise-website keep working
# unchanged. Copy the value from console/.env.production.
API_TOKEN_SALT=

# Watchtower-only — signs the admin panel's session JWT. Not shared with console.
ADMIN_JWT_SECRET=

# Comma-separated IPs allowed to reach /admin/** (panel UI only — does not apply to /api or /graphql).
WATCHTOWER_ADMIN_ALLOWED_IPS=

# Same Cloudinary account console uses, so existing media URLs keep resolving.
CLOUDINARY_NAME=
CLOUDINARY_KEY=
CLOUDINARY_SECRET=

# Root login (`/`) — phone+OTP+passkey, separate from /admin's email+password session.
# Signs the pending-2FA cookie and the full root session JWT. Never shared with ADMIN_JWT_SECRET.
ROOT_JWT_SECRET=

# HanuOTP SMS provider — same account/config as nexus (see nexus/.env.local), reused here so the
# same provider sends OTPs for both apps.
HANUOTP_API_KEY=
HANUOTP_TEMPLATE_SID=

# WebAuthn relying party config for passkey enrollment/login.
# RP_ID must be the bare domain (no scheme/port) the passkey is scoped to; localhost in dev.
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=Watchtower
WEBAUTHN_ORIGIN=http://localhost:3000

# Nexus API — used by /tickets to read Complaint records as an ADMIN service caller.
# NEXUS_JWT_SECRET must match nexus's JWT_SECRET exactly (see nexus/.env.local) — watchtower
# signs its own short-lived ADMIN-role token rather than logging in as a real nexus user.
NEXUS_API_URL=http://localhost:3000/api
NEXUS_JWT_SECRET=
