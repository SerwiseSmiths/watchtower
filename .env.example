# Postgres (Neon in production; local strapi_console DB for dev)
# DIRECT_URL is required by Prisma migrations/introspection against Neon's pooled connection.
DATABASE_URL=postgresql://user:password@host:5432/strapi_console?sslmode=require&pgbouncer=true
DIRECT_URL=postgresql://user:password@host:5432/strapi_console?sslmode=require

# Must match console's API_TOKEN_SALT exactly — used to verify existing Strapi API tokens
# (Authorization: Bearer <token>) via HMAC-SHA512, so nexus/serwise/serwise-website keep working
# unchanged. Copy the value from console/.env.production.
API_TOKEN_SALT=

# Watchtower-only — signs the admin panel's session JWT. Not shared with console.
ADMIN_JWT_SECRET=

# Comma-separated IPs allowed to reach /admin/** (panel UI only — does not apply to /api or /graphql).
WATCHTOWER_ADMIN_ALLOWED_IPS=

# Same Cloudinary account console uses, so existing media URLs keep resolving.
CLOUDINARY_NAME=
CLOUDINARY_KEY=
CLOUDINARY_SECRET=
