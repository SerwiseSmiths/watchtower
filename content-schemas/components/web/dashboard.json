{
  "collectionName": "components_web_dashboards",
  "info": {
    "displayName": "Dashboard",
    "icon": "apps",
    "description": "Website dashboard shown to signed-in customers — every label, tile, picture, link and colour. {name} is filled in live. Lives on the “dashboard” web page. The app QR and download link come from Global Config → APP_DOWNLOAD_LINK."
