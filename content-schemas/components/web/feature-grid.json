    },
    "cards": {
      "type": "component",
      "repeatable": true,
      "component": "web.feature-card"
    },
    "cardBackground": {
      "type": "customField",
      "customField": "plugin::color-picker.color",
      "options": {
        "format": "hex"
      }
    },
    "cardTitleStyle": {
      "type": "component",
      "repeatable": false,
      "component": "web.text-style"
    },
    "cardDescriptionStyle": {
      "type": "component",
      "repeatable": false,
      "component": "web.text-style"
    },
    "style": {
      "type": "component",
      "repeatable": false,
      "component": "web.section-style"
    }
  }
}
