{
  "collectionName": "components_web_feature_grids",
  "info": {
    "displayName": "Feature Grid",
    "description": "'Service & Beyond' — 2×2 illustrated feature cards"
  },
  "options": {},
  "attributes": {
    "heading": {
      "type": "string"
    },
    "headingStyle": {
      "type": "component",
      "repeatable": false,
